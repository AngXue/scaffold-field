{
  "name": "scaffold-field",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "android:setup": "bash scripts/setup-android-toolchain.sh",
    "android:sync": "npm run build && cap sync android",
    "apk": "bash scripts/build-apk.sh",
    "apk:release": "bash scripts/build-apk.sh release",
    "adb": "bash scripts/adb.sh",
    "audit:geometry": "node --experimental-strip-types scripts/geometry-audit/run.ts",
    "test:parity": "node scripts/calculation-parity/run.mjs",
    "audit:rules": "node scripts/calculation-parity/audit.mjs",
    "bench:rules": "node scripts/calculation-parity/run.mjs --bench",
    "rules:fingerprint": "node scripts/rule-fingerprint.ts",
    "predev": "npm run rules:fingerprint",
    "prebuild": "npm run rules:fingerprint",
    "pretest": "npm run rules:fingerprint",
    "pretest:parity": "npm run rules:fingerprint",
    "prebench:rules": "npm run rules:fingerprint",
    "preaudit:geometry": "npm run rules:fingerprint",
    "preaudit:rules": "node scripts/rule-fingerprint.ts --check",
    "test:rules": "node scripts/calculation-parity/acceptance.mjs",
    "pretest:rules": "npm run rules:fingerprint",
    "rules:docs": "node scripts/calculation-parity/rule-documents.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "lucide-react": "^1.47.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
